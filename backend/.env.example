# Backend Deployment Environment Variables Example
PORT=5000
NODE_ENV=production

# PostgreSQL Database Connection URL (e.g. from Render, Supabase, Neon, Railway)
DATABASE_URL="postgresql://username:password@hostname:5432/dbname?sslmode=require"

# JWT Authentication Secret
JWT_SECRET=super_secret_jwt_production_key_123456789
JWT_EXPIRES_IN=7d

# Google Gemini AI API Key
GEMINI_API_KEY=your_gemini_api_key_here

# (Optional) SMTP Email Configuration for Price Drop Alerts
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
